define partition_donate hypercall {
	call_num	0x75;
	flags		input bitfield partition_donate_flags;
	partition_cap	input type cap_id_t;
	arg2		input uregister;
	base		input type paddr_t;
	size		input size;
	res0		input uregister;
	error		output enumeration error;
};

define partition_query hypercall {
	call_num	0x76;
	partition_cap	input type cap_id_t;
	flags		input bitfield partition_query_flags;
	addr		input uregister;
	size		input size;
	arg4		input uregister;
	res0		input uregister;
	error		output enumeration error;
};

