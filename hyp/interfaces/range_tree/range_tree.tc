define range_tree structure {
	write_lock	structure spinlock;
	nr_rotations	uint64(atomic);
};

define range_tree_node structure {
	base	size;
	size	size;
};

define range_tree_lookup_result structure {
	node	pointer structure range_tree_node;
	size	size;
};

define range_tree_node_type enumeration {
	none;
};
