// SPE (Statistical Profiling Extension) type definitions

#if defined(ARCH_ARM_FEAT_SPE)
// Phase 2: Add SPE buffer interrupt support
extend vcpu_local_virq_type enumeration {
	spe_buffer = 3;
};

extend virq_trigger enumeration {
	spe_buffer;
};

// Phase 5: Add hardware interrupt action for SPE buffer interrupt
extend hwirq_action enumeration {
	spe_buffer;
};
#endif
