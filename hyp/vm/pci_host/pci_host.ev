module pci_host

subscribe object_create_pci_host
	require_lock(pci_host_create.pci_host->header.lock)

subscribe object_activate_pci_host
	priority last
	require_lock(pci_host->header.lock)

subscribe object_deactivate_pci_host

subscribe object_cleanup_pci_host(pci_host)

subscribe object_activate_pci_function
	priority last
	require_lock(pci_function->header.lock)

subscribe object_deactivate_pci_function

subscribe object_cleanup_pci_function(pci_function)

subscribe vdevice_access[VDEVICE_TYPE_PCI_HOST_CAM]
	handler pci_host_vdevice_access_cam(
		vdevice, offset, access_size, value, is_write)

subscribe vdevice_access[VDEVICE_TYPE_PCI_MEM_APERTURE]
	handler pci_host_vdevice_access_mem_aperture(
		vdevice, offset, access_size, value, is_write)

subscribe vpci_attach
	require_lock(vpci->header.lock)

subscribe vpci_config_read[VPCI_FUNCTION_TYPE_PASSTHROUGH]
	handler pci_host_passthrough_config_read(
	function, capability, offset, access_size)
	// This should be release_rcu_read.
	// FIXME: QC Gunyah issue #252
	require_rcu_read

subscribe vpci_config_write[VPCI_FUNCTION_TYPE_PASSTHROUGH]
	handler pci_host_passthrough_config_write(
	function, capability, offset, access_size, data)
	// This should be release_rcu_read.
	// FIXME: QC Gunyah issue #252
	require_rcu_read

subscribe vpci_config_read[VPCI_FUNCTION_TYPE_PHYSICAL]
	handler pci_host_physical_config_read(
	function, capability, offset, access_size)
	// This should be release_rcu_read.
	// FIXME: QC Gunyah issue #252
	require_rcu_read

subscribe vpci_config_write[VPCI_FUNCTION_TYPE_PHYSICAL]
	handler pci_host_physical_config_write(
	function, capability, offset, access_size, data)
	// This should be release_rcu_read.
	// FIXME: QC Gunyah issue #252
	require_rcu_read
