define pci_host_aperture_data structure {
	memextent		pointer object memextent;
	vmaddr			type vmaddr_t;
	list_node		structure list_node(contained);
	pci_host		pointer object pci_host;

	// vdevice structure to handle Memory aperture accesses.
	mem_aperture_vdevice structure vdevice(contained);
};

define pci_host_function_data structure {
	function		pointer object pci_function;
	cap_id			type cap_id_t;
	list_node		structure list_node(contained);
};

extend pci_function object {
	id		bitfield pci_responder_id;
	passedthrough	bool;
	option_flags	bitfield pci_function_option_flags;
	pci_host	pointer object pci_host;
	pci_vdevice	structure vpci_device;
	base_addr	uintptr;
	// PCI device function 0
	fn0		structure vpci_function(contained);
};

define pci_function_cap_data structure {
	base		structure vpci_capability_data(contained);
	flags		bitfield pci_capability_access_flags;
	function	pointer object pci_function;
};

extend pci_host object {
	// Object attachments.
	addrspace	pointer object addrspace;

	// Address ranges. These must not be changed after activation.
	memextent	pointer object memextent;
	cam_base	type vmaddr_t;
	cam_size	size;

	// Hold the hyp virt addr of ECAM
	cam_vaddr	uintptr;

	// Enable Lockdown
	lockdown	bool;

	// Is PCIe
	pcie		bool;

	// To hold the aperture memextent
	aperture_list	structure list;

	lock		structure spinlock;
	// lockdown state
	state		enumeration pci_host_lockdown_state;

	// To hold the pci_device(function) created for this
	// host_pci
	function_list		structure list;

	// Virtual device structure representing PCI Host CAM. If the
	// type is set to VDEVICE_TYPE_NONE, it has not been mapped.
	cam_vdevice			structure vdevice(contained);
};

extend vpci_function_type enumeration {
	passthrough;
	physical;
};

extend vdevice_type enumeration {
	pci_host_cam;
	pci_mem_aperture;
};

extend scheduler_block enumeration {
	pci_host_ecam_fault;
	pci_host_mem_aperture_fault;
};
