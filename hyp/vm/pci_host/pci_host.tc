define pci_host_aperture_data structure {
	memextent		pointer object memextent;
	vmaddr			type vmaddr_t;
	list_node		structure list_node(contained);
	pci_host		pointer object pci_host;
};

extend pci_host object {
	// Object attachments.
	addrspace	pointer object addrspace;

	// Address ranges. These must not be changed after activation.
	memextent	pointer object memextent;
	cam_base	type vmaddr_t;
	cam_size	size;

	// Hold the hyp virt addr of ECAM
	cam_vaddr	uintptr;

	// Enable Lockdown
	lockdown	bool;

	// Is PCIe
	pcie		bool;

	// To hold the aperture memextent
	aperture_list	structure list;

	lock		structure spinlock;
	// lockdown state
	state		enumeration pci_host_lockdown_state;
};
